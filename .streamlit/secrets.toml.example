# Streamlit Community Cloud secrets. Paste the contents of this file (with real values)
# into Manage app -> Settings -> Secrets. Do NOT copy REQUESTS_CA_BUNDLE / SSL_CERT_FILE
# from your local .env: those point at paths that only exist on your machine.
#
# Everything here is optional. With no secrets at all the app still runs: it falls back to
# the offline pandas graph and template-based narration.

# ---- LLM narration (optional) ----
CLARA_LLM_PROVIDER = "gemini"          # gemini | anthropic | none
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.6-flash"
# ANTHROPIC_API_KEY = ""
# ANTHROPIC_MODEL = "claude-sonnet-5"

# ---- TigerGraph Savanna (optional; omit to run on the offline pandas graph) ----
CLARA_GRAPH_BACKEND = "tigergraph"
TG_HOST = ""
TG_GRAPHNAME = "DefAttack"
TG_USERNAME = ""
TG_PASSWORD = ""
TG_SECRET = ""
TG_TGCLOUD = "true"
